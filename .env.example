TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-chat-id

EDNEVNIK_USERNAME=your.name@skole.hr
EDNEVNIK_PASSWORD=your-password

# Comma-separated Telegram user IDs allowed to use the bot (get yours from @userinfobot)
ALLOWED_USER_IDS=123456789

# Daily check time (24h format)
DAILY_CHECK_TIME=08:00
TIMEZONE=Europe/Zagreb

# Path to grades storage file (leave default unless you have a reason to change)
STORAGE_FILE=data/grades.json
